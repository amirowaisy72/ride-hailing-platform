index 0000000..5fb3f9a
--- /dev/null
+++ b/backend/src/services/refundService.js
@@ -0,0 +1,147 @@
+const mongoose = require("mongoose");
+const PaymentOrder = require("../models/PaymentOrder");
+const DriverWallet = require("../models/DriverWallet");
+const WalletTransaction = require("../models/WalletTransaction");
+
+// Admin-approved refund of a COMPLETED driver wallet top-up.
+//
+// Scope: ledger reversal only. The money return on the gateway side
+// stays MANUAL — the admin returns the amount from the merchant
+// portal (or reverses the bank transfer) and records that reference
+// on the order (gatewayRefundReference). This service debits the
+// driver's wallet back and marks the order REFUNDED.
+//
+// Rules: full amount only; the order must be CREDITED; the original
+// TOP_UP ledger entry must exist; the wallet must still hold at
+// least the top-up amount (no silent partial refunds). Idempotent:
+// a second call returns the existing refund instead of double-debiting.
+async function refundTopUpOrder(orderId, adminUserId, options = {}) {
+    if (!mongoose.isValidObjectId(orderId)) {
+        throw new Error("Invalid payment order");
+    }
+
+    const reason =
+        typeof options.reason === "string" ? options.reason.trim() : "";
+    const gatewayRefundReference =
+        typeof options.gatewayRefundReference === "string" &&
+        options.gatewayRefundReference.trim()
+            ? options.gatewayRefundReference.trim()
+            : null;
+
+    return mongoose.connection.transaction(async (session) => {
+        const order = await PaymentOrder.findById(orderId).session(session);
+
+        if (!order) {
+            throw new Error("Payment order not found");
+        }
+
+        const idempotencyKey = `refund:${order._id}`;
+
+        const existing = await WalletTransaction.findOne({
+            idempotencyKey,
+        }).session(session);
+
+        if (existing) {
+            if (order.status !== "REFUNDED") {
+                throw new Error("Refund reconciliation required");
+            }
+
+            return {
+                alreadyRefunded: true,
+                transaction: existing,
+            };
+        }
+
+        if (order.status !== "CREDITED") {
+            throw new Error("Only a credited top-up can be refunded");
+        }
+
+        const original = await WalletTransaction.findOne({
+            idempotencyKey: `payment:${order._id}`,
+        }).session(session);
+
+        if (!original || original.type !== "TOP_UP") {
+            throw new Error("Original top-up ledger entry not found");
+        }
+
+        const wallet = await DriverWallet.findOne({
+            driverId: order.driverId,
+        }).session(session);
+
+        if (!wallet) {
+            throw new Error("Driver wallet not found");
+        }
+
+        if (
+            !Number.isSafeInteger(wallet.balance) ||
+            wallet.balance < order.amount
+        ) {
+            throw new Error(
+                "Wallet balance is below the top-up amount; a full refund is not possible"
+            );
+        }
+
+        const updated = await DriverWallet.findOneAndUpdate(
+            {
+                _id: wallet._id,
+                balance: wallet.balance,
+            },
+            {
+                $inc: {
+                    balance: -order.amount,
+                    totalTopUps: -order.amount,
+                },
+            },
+            { session, returnDocument: "after" }
+        );
+
+        if (!updated) {
+            throw new Error("Wallet changed; retry refund");
+        }
+
+        // NOTE: paymentOrderId stays null on the refund row — the
+        // ledger has a unique partial index on paymentOrderId and the
+        // original TOP_UP row already owns this order's id. The
+        // refund is traced via idempotencyKey `refund:<orderId>` and
+        // its own paymentReference (the gateway refund reference, or a
+        // derived unique value when the admin did not supply one).
+        const [transaction] = await WalletTransaction.create(
+            [{
+                walletId: wallet._id,
+                driverId: order.driverId,
+                type: "REFUND",
+                amount: order.amount,
+                balanceBefore: wallet.balance,
+                balanceAfter: updated.balance,
+                description: (
+                    `Refund of ${order.gateway} top-up ${order._id}` +
+                    (reason ? `: ${reason}` : "")
+                ).slice(0, 500),
+                idempotencyKey,
+                paymentGateway: order.gateway,
+                paymentReference:
+                    gatewayRefundReference || `refund:${order._id}`,
+                paymentStatus: "VERIFIED",
+                paymentAmount: order.amount,
+                paymentCurrency: "PKR",
+                createdBy: adminUserId || null,
+            }],
+            { session }
+        );
+
+        order.status = "REFUNDED";
+        order.refundedAt = new Date();
+        order.refundedBy = adminUserId || null;
+        order.refundReason = reason;
+        order.gatewayRefundReference = gatewayRefundReference;
+        await order.save({ session });
+
+        return {
+            alreadyRefunded: false,
+            transaction,
+            balance: updated.balance,
+        };
+    });
+}
+
+module.exports = { refundTopUpOrder };
diff --git a/backend/src/services/ublPaymentService.js b/backend/src/services/ublPaymentService.js
new file mode 100644
index 0000000..3baa107
--- /dev/null
+++ b/backend/src/services/ublPaymentService.js
@@ -0,0 +1,161 @@
+const crypto = require("crypto");
+
+// UBL hosted-checkout integration for DRIVER WALLET TOP-UPS,
+// mirroring services/jazzCashPaymentService.js: a signed checkout
+// form is built from the dashboard-saved merchant credentials, and
+// the gateway's signed response is verified (timing-safe) before the
+// callback controller credits the wallet.
+//
+// Credentials contract (admin dashboard, provider UBL):
+//   merchantId — UBL merchant id
+//   password   — merchant terminal/password value
+//   hashKey    — merchant secure hash key issued by UBL
+//   paymentUrl — hosted checkout URL (HTTPS, issued merchant portal)
+
+const SIGNATURE_FIELD = "pp_SecureHash";
+
+function calculateAmountInMinor(amount) {
+    if (
+        !Number.isSafeInteger(amount) ||
+        amount < 1 ||
+        amount > 1000000
+    ) {
+        throw new Error("Invalid payment amount");
+    }
+
+    return String(amount * 100);
+}
+
+function generateSignature(fields, hashKey) {
+    if (typeof hashKey !== "string" || !hashKey.trim()) {
+        throw new Error("UBL hash key is required");
+    }
+
+    const values = Object.keys(fields)
+        .filter(
+            (key) =>
+                key !== SIGNATURE_FIELD &&
+                fields[key] !== undefined &&
+                fields[key] !== null &&
+                String(fields[key]) !== ""
+        )
+        .sort()
+        .map((key) => String(fields[key]));
+
+    const message = `${hashKey}&${values.join("&")}`;
+    const latin1Message = Buffer.from(
+        Buffer.from(message, "utf8").toString("latin1"),
+        "latin1"
+    );
+
+    return crypto
+        .createHmac("sha256", Buffer.from(hashKey, "utf8"))
+        .update(latin1Message)
+        .digest("hex");
+}
+
+function createUblCheckout({ order, credentials, returnUrl }) {
+    if (!order || !credentials) {
+        throw new Error("Payment order and credentials are required");
+    }
+
+    const { merchantId, password, hashKey, paymentUrl } = credentials;
+
+    if (!merchantId || !password || !hashKey || !paymentUrl) {
+        throw new Error("UBL merchant configuration is incomplete");
+    }
+
+    if (typeof returnUrl !== "string" || !returnUrl.trim()) {
+        throw new Error("Payment return URL is required");
+    }
+
+    const callbackUrl = new URL(returnUrl);
+
+    if (
+        callbackUrl.protocol !== "https:" ||
+        callbackUrl.pathname !== "/api/v1/payments/ubl/callback"
+    ) {
+        throw new Error("Invalid UBL callback URL");
+    }
+
+    const url = new URL(paymentUrl);
+
+    if (url.protocol !== "https:") {
+        throw new Error("Unapproved UBL payment URL");
+    }
+
+    const now = new Date();
+
+    const formatTimestamp = (date) =>
+        date.getFullYear().toString() +
+        String(date.getMonth() + 1).padStart(2, "0") +
+        String(date.getDate()).padStart(2, "0") +
+        String(date.getHours()).padStart(2, "0") +
+        String(date.getMinutes()).padStart(2, "0") +
+        String(date.getSeconds()).padStart(2, "0");
+
+    const fields = {
+        pp_MerchantID: merchantId,
+        pp_Password: password,
+        pp_TxnRefNo: order.merchantTxnReference,
+        pp_Amount: calculateAmountInMinor(order.amount),
+        pp_TxnCurrency: "PKR",
+        pp_TxnDateTime: formatTimestamp(now),
+        pp_BillReference: `W${String(order._id).slice(-12)}`,
+        pp_Description: "Safar driver wallet top-up",
+        pp_ReturnURL: returnUrl,
+    };
+
+    fields[SIGNATURE_FIELD] = generateSignature(fields, hashKey);
+
+    return {
+        paymentUrl: url.toString(),
+        fields,
+    };
+}
+
+function verifyUblResponse(response, hashKey) {
+    if (
+        !response ||
+        typeof response !== "object" ||
+        typeof response[SIGNATURE_FIELD] !== "string" ||
+        typeof response.pp_TxnRefNo !== "string" ||
+        typeof response.pp_ResponseCode !== "string"
+    ) {
+        return false;
+    }
+
+    const fields = Object.fromEntries(
+        Object.entries(response).filter(
+            ([key, value]) =>
+                key.startsWith("pp_") &&
+                key !== SIGNATURE_FIELD &&
+                value !== undefined &&
+                value !== null &&
+                String(value) !== ""
+        )
+    );
+
+    const expected = generateSignature(fields, hashKey).toUpperCase();
+    const received = response[SIGNATURE_FIELD].toUpperCase();
+
+    if (
+        !/^[A-F0-9]{64}$/.test(received) ||
+        !/^[A-F0-9]{64}$/.test(expected)
+    ) {
+        return false;
+    }
+
+    return crypto.timingSafeEqual(
+        Buffer.from(expected, "hex"),
+        Buffer.from(received, "hex")
+    );
+}
+
+module.exports = {
+    calculateAmountInMinor,
+    createUblCheckout,
+    generateSignature,
+    verifyUblResponse,
+    UBL_SIGNATURE_FIELD: SIGNATURE_FIELD,
+};
diff --git a/backend/src/utils/paymentResultRedirect.js b/backend/src/utils/paymentResultRedirect.js
new file mode 100644
index 0000000..eb25f00
--- /dev/null
+++ b/backend/src/utils/paymentResultRedirect.js
@@ -0,0 +1,53 @@
+const CommissionSettings = require("../models/CommissionSettings");
+const {
+    getPaymentResultUrl,
+} = require("../services/paymentsConfigService");
+
+// Shared post-payment redirect for all gateway callback controllers.
+// The result URL comes from the dashboard-managed commission settings
+// first, with PAYMENT_RESULT_URL as the environment fallback. When no
+// result URL is configured, the callback answers with JSON instead.
+async function redirectToPaymentResult(res, order, status, message) {
+    const settings = await CommissionSettings.findOne({
+        key: "GLOBAL",
+    })
+        .select("paymentResultUrl")
+        .lean();
+
+    const target = getPaymentResultUrl(settings);
+
+    if (!target) {
+        return res.json({
+            success: status === "success",
+            message,
+            orderId: String(order._id),
+            status,
+        });
+    }
+
+    const url = new URL(target);
+
+    const isLocalhost =
+        url.hostname === "localhost" &&
+        ["http:", "https:"].includes(url.protocol);
+
+    const isSafarAppReturn =
+        url.protocol === "com.safar.ridehailing:" &&
+        url.hostname === "driver" &&
+        url.pathname === "/earnings";
+
+    if (
+        url.protocol !== "https:" &&
+        !isLocalhost &&
+        !isSafarAppReturn
+    ) {
+        throw new Error("Invalid payment result URL");
+    }
+
+    url.searchParams.set("paymentStatus", status);
+    url.searchParams.set("paymentOrderId", String(order._id));
+
+    return res.redirect(303, url.toString());
+}
+
+module.exports = { redirectToPaymentResult };
