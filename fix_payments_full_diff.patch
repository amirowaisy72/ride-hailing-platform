diff --git a/backend/src/services/easyPaisaPaymentService.js b/backend/src/services/easyPaisaPaymentService.js
new file mode 100644
index 0000000..f2f9657
--- /dev/null
+++ b/backend/src/services/easyPaisaPaymentService.js
@@ -0,0 +1,163 @@
+const crypto = require("crypto");
+
+// EasyPaisa hosted-checkout integration for DRIVER WALLET TOP-UPS,
+// mirroring services/jazzCashPaymentService.js: a signed checkout form
+// is built from the dashboard-saved merchant credentials, and the
+// gateway's signed response is verified (timing-safe) before the
+// callback controller credits the wallet.
+//
+// Credentials contract (admin dashboard, provider EASYPAISA):
+//   storeId    — EasyPaisa merchant store id
+//   hashKey    — merchant hash key issued with the store
+//   paymentUrl — hosted checkout URL (easypay / easypaystg hosts)
+
+const HASH_FIELD = "merchantHashedReq";
+
+function generateMerchantHash(fields, hashKey) {
+    if (typeof hashKey !== "string" || !hashKey.trim()) {
+        throw new Error("EasyPaisa hash key is required");
+    }
+
+    const values = Object.keys(fields)
+        .filter(
+            (key) =>
+                key !== HASH_FIELD &&
+                fields[key] !== undefined &&
+                fields[key] !== null &&
+                String(fields[key]) !== ""
+        )
+        .sort()
+        .map((key) => String(fields[key]));
+
+    const message = `${hashKey}&${values.join("&")}`;
+    const latin1Message = Buffer.from(
+        Buffer.from(message, "utf8").toString("latin1"),
+        "latin1"
+    );
+
+    return crypto
+        .createHmac("sha256", Buffer.from(hashKey, "utf8"))
+        .update(latin1Message)
+        .digest("hex");
+}
+
+function createEasyPaisaCheckout({ order, credentials, returnUrl }) {
+    if (!order || !credentials) {
+        throw new Error("Payment order and credentials are required");
+    }
+
+    if (
+        !Number.isSafeInteger(order.amount) ||
+        order.amount < 1 ||
+        order.amount > 1000000
+    ) {
+        throw new Error("Invalid payment amount");
+    }
+
+    const { storeId, hashKey, paymentUrl } = credentials;
+
+    if (!storeId || !hashKey || !paymentUrl) {
+        throw new Error("EasyPaisa merchant configuration is incomplete");
+    }
+
+    if (typeof returnUrl !== "string" || !returnUrl.trim()) {
+        throw new Error("Payment return URL is required");
+    }
+
+    const callbackUrl = new URL(returnUrl);
+
+    if (
+        callbackUrl.protocol !== "https:" ||
+        callbackUrl.pathname !== "/api/v1/payments/easypaisa/callback"
+    ) {
+        throw new Error("Invalid EasyPaisa callback URL");
+    }
+
+    const url = new URL(paymentUrl);
+
+    const allowedHosts = [
+        "easypay.easypaisa.com.pk",
+        "easypaystg.easypaisa.com.pk",
+    ];
+
+    if (
+        url.protocol !== "https:" ||
+        !allowedHosts.includes(url.hostname)
+    ) {
+        throw new Error("Unapproved EasyPaisa payment URL");
+    }
+
+    const now = new Date();
+    const expiry = new Date(now.getTime() + 15 * 60 * 1000);
+
+    const formatTimestamp = (date) =>
+        date.getFullYear().toString() +
+        String(date.getMonth() + 1).padStart(2, "0") +
+        String(date.getDate()).padStart(2, "0") +
+        String(date.getHours()).padStart(2, "0") +
+        String(date.getMinutes()).padStart(2, "0") +
+        String(date.getSeconds()).padStart(2, "0");
+
+    const fields = {
+        storeId,
+        orderRefNum: order.merchantTxnReference,
+        transactionAmount: order.amount.toFixed(2),
+        transactionCurrency: "PKR",
+        paymentMethod: credentials.paymentMethod || "MA",
+        postBackURL: returnUrl,
+        transactionDateTime: formatTimestamp(now),
+        expiryDateTime: formatTimestamp(expiry),
+        description: "Safar driver wallet top-up",
+    };
+
+    fields[HASH_FIELD] = generateMerchantHash(fields, hashKey);
+
+    return {
+        paymentUrl: url.toString(),
+        fields,
+    };
+}
+
+function verifyEasyPaisaResponse(response, hashKey) {
+    if (
+        !response ||
+        typeof response !== "object" ||
+        typeof response[HASH_FIELD] !== "string" ||
+        typeof response.orderRefNum !== "string" ||
+        typeof response.responseCode !== "string"
+    ) {
+        return false;
+    }
+
+    const fields = Object.fromEntries(
+        Object.entries(response).filter(
+            ([key, value]) =>
+                key !== HASH_FIELD &&
+                value !== undefined &&
+                value !== null &&
+                String(value) !== ""
+        )
+    );
+
+    const expected = generateMerchantHash(fields, hashKey).toUpperCase();
+    const received = response[HASH_FIELD].toUpperCase();
+
+    if (
+        !/^[A-F0-9]{64}$/.test(received) ||
+        !/^[A-F0-9]{64}$/.test(expected)
+    ) {
+        return false;
+    }
+
+    return crypto.timingSafeEqual(
+        Buffer.from(expected, "hex"),
+        Buffer.from(received, "hex")
+    );
+}
+
+module.exports = {
+    createEasyPaisaCheckout,
+    generateMerchantHash,
+    verifyEasyPaisaResponse,
+    EASYPAISA_HASH_FIELD: HASH_FIELD,
+};
diff --git a/backend/src/services/parcelSettlementService.js b/backend/src/services/parcelSettlementService.js
new file mode 100644
index 0000000..8069732
--- /dev/null
+++ b/backend/src/services/parcelSettlementService.js
@@ -0,0 +1,236 @@
+const mongoose = require("mongoose");
+
+const ParcelOrder = require("../models/ParcelOrder");
+const DriverWallet = require("../models/DriverWallet");
+const WalletTransaction = require("../models/WalletTransaction");
+const CommissionSettings = require("../models/CommissionSettings");
+const ParcelSettlement = require("../models/ParcelSettlement");
+const { ensureDriverWallet } = require("./driverWalletService");
+const { paymentsConfigured } = require("./paymentsConfigService");
+
+// Parcel commission settlement, mirroring settleRideCommission for
+// rides: same GLOBAL settings, same auto free-mode rule, same wallet
+// CAS debit. Idempotency key: `commission:parcel:<parcelOrderId>`.
+// The fare is the accepted final price; the requested price is the
+// fallback when no final price was recorded.
+async function settleParcelCommission(parcelOrderId) {
+    if (!mongoose.isValidObjectId(parcelOrderId)) {
+        throw new Error("Invalid parcel order ID");
+    }
+
+    return mongoose.connection.transaction(async (session) => {
+        const existing = await ParcelSettlement.findOne({
+            parcelOrderId,
+        }).session(session);
+
+        if (existing?.status === "SETTLED") {
+            return {
+                alreadySettled: true,
+                settlement: existing,
+            };
+        }
+
+        if (existing && !["PENDING", "FAILED"].includes(existing.status)) {
+            throw new Error("Invalid settlement status");
+        }
+
+        const idempotencyKey = `commission:parcel:${parcelOrderId}`;
+
+        const previousDebit = await WalletTransaction.findOne({
+            idempotencyKey,
+        }).session(session);
+
+        if (previousDebit) {
+            throw new Error(
+                "Existing commission debit requires manual reconciliation"
+            );
+        }
+
+        const parcel = await ParcelOrder.findById(parcelOrderId)
+            .session(session);
+
+        const fare =
+            Number.isSafeInteger(parcel?.finalPrice) && parcel.finalPrice > 0
+                ? parcel.finalPrice
+                : Number.isSafeInteger(parcel?.requestedPrice) &&
+                    parcel.requestedPrice > 0
+                    ? parcel.requestedPrice
+                    : null;
+
+        if (
+            !parcel ||
+            parcel.status !== "DELIVERED" ||
+            !parcel.driverId ||
+            fare === null
+        ) {
+            throw new Error("Invalid delivered parcel");
+        }
+
+        const settings = await CommissionSettings.findOne({
+            key: "GLOBAL",
+        }).session(session);
+
+        // Auto Free Mode (same rule as rides): no configured payment
+        // method → zero commission, settle as free, never fail.
+        const configured = await paymentsConfigured(settings, session);
+
+        const topUpEnforced =
+            settings?.topUpRequired === true && configured;
+
+        if (topUpEnforced && settings.isActive !== true) {
+            throw new Error("Active commission settings unavailable");
+        }
+
+        const basisPoints =
+            topUpEnforced && settings.isActive === true
+                ? Math.round(settings.percentage * 100)
+                : 0;
+
+        if (
+            !Number.isSafeInteger(basisPoints) ||
+            basisPoints < 0 ||
+            basisPoints > 10000
+        ) {
+            throw new Error("Invalid commission rate");
+        }
+
+        const commission = Math.round((fare * basisPoints) / 10000);
+
+        if (
+            !Number.isSafeInteger(commission) ||
+            commission < 0 ||
+            commission > fare
+        ) {
+            throw new Error("Invalid calculated commission");
+        }
+
+        const wallet = await ensureDriverWallet(
+            parcel.driverId,
+            session
+        );
+
+        if (
+            !Number.isSafeInteger(wallet.balance) ||
+            wallet.balance < commission
+        ) {
+            throw new Error("Insufficient driver wallet balance");
+        }
+
+        let balanceAfter = wallet.balance;
+
+        if (commission > 0) {
+            const updatedWallet = await DriverWallet.findOneAndUpdate(
+                {
+                    _id: wallet._id,
+                    balance: wallet.balance,
+                },
+                {
+                    $inc: {
+                        balance: -commission,
+                        totalCommission: commission,
+                    },
+                },
+                {
+                    returnDocument: "after",
+                    session,
+                }
+            );
+
+            if (!updatedWallet) {
+                throw new Error("Wallet balance changed; retry required");
+            }
+
+            balanceAfter = updatedWallet.balance;
+
+            await WalletTransaction.create(
+                [
+                    {
+                        walletId: wallet._id,
+                        driverId: parcel.driverId,
+                        rideId: null,
+                        parcelOrderId: parcel._id,
+                        type: "COMMISSION_DEBIT",
+                        amount: commission,
+                        balanceBefore: wallet.balance,
+                        balanceAfter,
+                        description: `Commission for parcel ${parcel._id}`,
+                        idempotencyKey,
+                    },
+                ],
+                { session }
+            );
+        }
+
+        const settledAt = new Date();
+
+        const settlement = existing
+            ? await ParcelSettlement.findOneAndUpdate(
+                {
+                    _id: existing._id,
+                    status: existing.status,
+                },
+                {
+                    $set: {
+                        driverId: parcel.driverId,
+                        fare,
+                        commission,
+                        commissionPercentage: basisPoints / 100,
+                        driverEarnings: fare - commission,
+                        currency: "PKR",
+                        status: "SETTLED",
+                        settledAt,
+                        lastError: "",
+                    },
+                },
+                { session, returnDocument: "after" }
+            )
+            : null;
+
+        if (existing && !settlement) {
+            throw new Error("Settlement changed; retry required");
+        }
+
+        const [createdSettlement] = existing ? [null] : await ParcelSettlement.create(
+            [
+                {
+                    parcelOrderId: parcel._id,
+                    driverId: parcel.driverId,
+                    fare,
+                    commission,
+                    commissionPercentage: basisPoints / 100,
+                    driverEarnings: fare - commission,
+                    currency: "PKR",
+                    status: "SETTLED",
+                    settledAt,
+                },
+            ],
+            { session }
+        );
+
+        await ParcelOrder.updateOne(
+            {
+                _id: parcel._id,
+                status: "DELIVERED",
+            },
+            {
+                $set: {
+                    settlementStatus: "SETTLED",
+                    settlementError: "",
+                    settledAt,
+                },
+                $inc: {
+                    settlementAttempts: 1,
+                },
+            },
+            { session }
+        );
+
+        return {
+            alreadySettled: false,
+            settlement: settlement || createdSettlement,
+            balanceAfter,
+        };
+    });
+}
+
+module.exports = { settleParcelCommission };
diff --git a/backend/src/services/paymentsConfigService.js b/backend/src/services/paymentsConfigService.js
new file mode 100644
index 0000000..6643b25
--- /dev/null
+++ b/backend/src/services/paymentsConfigService.js
@@ -0,0 +1,127 @@
+const CommissionSettings = require("../models/CommissionSettings");
+const PaymentGatewayConfig = require("../models/PaymentGatewayConfig");
+
+// Production callback route (deployed backend). Used as the default
+// return URL when neither the dashboard setting nor the environment
+// provides one, so a fresh deployment works without .env edits.
+const DEFAULT_PAYMENT_RETURN_URL =
+    "https://ride-hailing-api-tezd.onrender.com/api/v1/payments/jazzcash/callback";
+
+// Single source of truth for "can drivers actually pay online right
+// now?". Until at least one payment method is configured, the platform
+// runs in FREE mode: commission enforcement is skipped everywhere and
+// settlements complete with zero commission instead of failing.
+// The moment a gateway (or the bank-transfer receiving account) is
+// configured, normal commission behaviour resumes automatically —
+// no flags to flip, no redeploy.
+
+function getActiveEnvironment(settings) {
+    return settings?.paymentEnvironment === "LIVE" ? "LIVE" : "TEST";
+}
+
+function bankTransferConfigured(settings) {
+    return Boolean(
+        typeof settings?.bankName === "string" &&
+        settings.bankName.trim() &&
+        typeof settings?.bankAccountTitle === "string" &&
+        settings.bankAccountTitle.trim() &&
+        typeof settings?.bankAccountNumber === "string" &&
+        settings.bankAccountNumber.trim()
+    );
+}
+
+async function paymentsConfigured(settings = null, session = null) {
+    let globalSettings = settings;
+
+    if (!globalSettings) {
+        globalSettings = await CommissionSettings.findOne({
+            key: "GLOBAL",
+        }).lean();
+    }
+
+    if (bankTransferConfigured(globalSettings)) {
+        return true;
+    }
+
+    const environment = getActiveEnvironment(globalSettings);
+
+    let query = PaymentGatewayConfig.findOne({
+        provider: { $in: ["JAZZCASH", "EASYPAISA", "UBL"] },
+        enabled: true,
+        environment,
+        encryptedCredentials: {
+            $exists: true,
+            $nin: [null, ""],
+        },
+    }).select("_id");
+
+    if (session) {
+        query = query.session(session);
+    }
+
+    const config = await query.lean();
+
+    return Boolean(config);
+}
+
+// Dashboard setting first, environment as fallback, production route
+// as the final default.
+function getPaymentReturnUrl(settings) {
+    const fromSettings =
+        typeof settings?.paymentReturnUrl === "string"
+            ? settings.paymentReturnUrl.trim()
+            : "";
+
+    return (
+        fromSettings ||
+        process.env.PAYMENT_RETURN_URL ||
+        DEFAULT_PAYMENT_RETURN_URL
+    );
+}
+
+function getPaymentResultUrl(settings) {
+    const fromSettings =
+        typeof settings?.paymentResultUrl === "string"
+            ? settings.paymentResultUrl.trim()
+            : "";
+
+    return fromSettings || process.env.PAYMENT_RESULT_URL || "";
+}
+
+// Every gateway's callback lives under /api/v1/payments/<provider>/
+// callback on the same backend, so a provider callback URL is derived
+// from the configured JazzCash return URL by swapping the provider
+// path segment.
+function getGatewayCallbackUrl(settings, provider) {
+    const base = getPaymentReturnUrl(settings);
+
+    if (provider === "JAZZCASH") {
+        return base;
+    }
+
+    const segment = `/jazzcash/callback`;
+
+    if (base.includes(segment)) {
+        return base.replace(
+            segment,
+            `/${provider.toLowerCase()}/callback`
+        );
+    }
+
+    try {
+        const url = new URL(base);
+        return `${url.origin}/api/v1/payments/${provider.toLowerCase()}/callback`;
+    } catch {
+        return `https://ride-hailing-api-tezd.onrender.com/api/v1/payments/${provider.toLowerCase()}/callback`;
+    }
+}
+
+module.exports = {
+    getActiveEnvironment,
+    bankTransferConfigured,
+    paymentsConfigured,
+    getPaymentReturnUrl,
+    getPaymentResultUrl,
+    getGatewayCallbackUrl,
+    DEFAULT_PAYMENT_RETURN_URL,
+};
